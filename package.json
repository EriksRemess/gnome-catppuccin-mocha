{
  "name": "gnome-catppuccin-mocha",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Maintainable Catppuccin Mocha themes for GNOME Shell, GDM, GTK 3, and GTK 4",
  "scripts": {
    "build": "node scripts/build-theme.js",
    "check": "node scripts/build-theme.js --check && node scripts/check-upstream.js",
    "upstream:check": "node scripts/check-upstream.js",
    "upstream:update": "node scripts/update-upstream.js",
    "test": "make check"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "sass": "1.105.0"
  }
}
